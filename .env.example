# =====================================================
# Portfolio AI Agent — environment variables
# =====================================================
# Copy this file to .env.local for local development
# and set the same values in Vercel project settings for production.

# ----- OpenRouter (LLM) -----
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ----- Cal.com (meeting booking) -----
# Get key: cal.com -> Settings -> Developer -> API keys -> + Add
# Starts with cal_live_...
CAL_API_KEY=cal_live_...

# The numeric ID of your 15-min event type.
# Find it: GET https://api.cal.com/v2/event-types with your key,
# or visit https://app.cal.com/event-types and check the URL.
CAL_EVENT_TYPE_ID=12345

# Your Cal.com username (lowercase, e.g. "taiyab")
CAL_USERNAME=taiyab

# ----- Resend (email messages) -----
# Get key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# Sender. For testing without domain verification, use the default:
#   RESEND_FROM="Portfolio AI <onboarding@resend.dev>"
# Once you verify autostrata.ai in Resend, switch to a custom address:
#   RESEND_FROM="Portfolio AI <noreply@autostrata.ai>"
RESEND_FROM=Portfolio AI <onboarding@resend.dev>

# Where messages get delivered
NOTIFY_EMAIL=mohammadtaiyabkhan21@gmail.com
